{
  "name": "replicas",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "web",
    "admin",
    "cli",
    "computer-use",
    "engine",
    "shared",
    "client-data",
    "monolith",
    "services/email-worker",
    "mcp",
    "mobile",
    "mobile-next",
    "mobile-next/quality",
    "desktop-app"
  ],
  "scripts": {
    "changelog:generate": "bun scripts/generate-weekly-update.mjs",
    "changelog:check": "bun scripts/generate-weekly-update.mjs --check",
    "clickhouse:migrate": "node scripts/apply-clickhouse-migrations.mjs",
    "db:new": "dbmate new",
    "db:migrate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable}\" dbmate --migrations-table dbmate.schema_migrations --no-dump-schema up",
    "db:reset": "supabase db reset; bun run db:migrate && docker exec -i supabase_db_replicas psql -U postgres -v ON_ERROR_STOP=1 < db/seed.sql",
    "db:setup": "if t=$(docker exec supabase_db_replicas psql -U postgres -tAc \"select to_regclass('dbmate.schema_migrations')\") && [ -z \"$t\" ]; then bun run db:reset; else bun run db:migrate; fi",
    "db:codegen": "bun run --filter monolith db:codegen",
    "dev:seed": "bash scripts/dev-seed.sh",
    "dev:token": "bash scripts/dev-token.sh",
    "docs:generate-plugin-schemas": "bun scripts/generate-openapi-plugin-schemas.ts",
    "generate:persisted-query-hashes": "bun scripts/persisted-query-hashes.ts",
    "lint": "bun run --cwd web lint && bun run --cwd admin lint && NODE_OPTIONS=--max-old-space-size=8192 eslint \"{mobile,mobile-next,desktop-app}/**/*.{ts,tsx}\" \"{shared,client-data}/src/**/*.{ts,tsx}\" \"{monolith,engine,cli}/src/**/*.ts\"",
    "check:foreign-keys": "node scripts/check-foreign-keys.mjs",
    "check:symlinks": "node scripts/check-symlinks.mjs",
    "check:pg-promise-imports": "node scripts/check-pg-promise-imports.mjs",
    "check:react-compiler": "node scripts/check-react-compiler.mjs",
    "check:migrations:idempotent": "node scripts/check-migration-idempotency.mjs",
    "check:migrations:timestamps": "node scripts/check-migration-timestamps.mjs",
    "typecheck": "bun run --filter @replicas/shared build && bun run --filter '*' typecheck",
    "test": "bun test ./scripts ./mobile ./mobile-next/src && bun run --filter '*' test"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@posthog/cli": "0.18.12",
    "@tensorlakeai/tensorlake": "0.5.159",
    "babel-plugin-react-compiler": "1.0.0",
    "dbmate": "2.36.0",
    "e2b": "2.60.0",
    "esbuild": "^0.28.1",
    "eslint": "9.39.5",
    "libpg-query": "17.7.4",
    "supabase": "2.31.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "shiki": "3.23.0",
    "@shikijs/transformers": "3.23.0",
    "@smithy/types": "4.14.1",
    "@smithy/smithy-client": "4.12.13",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/query-core": "5.104.5",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/core": "2.3.0",
    "dompurify": "3.4.17",
    "katex": "0.18.10",
    "postcss": "8.5.32",
    "prosemirror-model": "1.25.13",
    "prosemirror-transform": "1.12.5",
    "prosemirror-view": "1.42.9",
    "protobufjs": "7.6.6",
    "tar": "7.5.22"
  },
  "patchedDependencies": {
    "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch",
    "@pierre/trees@1.0.0-beta.6": "patches/@pierre%2Ftrees@1.0.0-beta.6.patch",
    "react-native-enriched-markdown@1.1.1": "patches/react-native-enriched-markdown@1.1.1.patch",
    "react-native-keyboard-controller@1.22.7": "patches/react-native-keyboard-controller@1.22.7.patch",
    "react-native-screens@4.30.0": "patches/react-native-screens@4.30.0.patch",
    "react-native-webview@14.0.1": "patches/react-native-webview@14.0.1.patch",
    "@legendapp/list@3.7.0": "patches/@legendapp%2Flist@3.7.0.patch"
  }
}
