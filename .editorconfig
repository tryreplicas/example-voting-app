# EditorConfig: https://editorconfig.org
# Matches the conventions already used in this repository (MY-3).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# Python (vote, seed-data)
[*.py]
indent_style = space
indent_size = 4

# C# worker
[*.cs]
indent_style = space
indent_size = 4

[*.csproj]
indent_style = space
indent_size = 2

# Dockerfiles
[Dockerfile]
indent_style = space
indent_size = 4

# JavaScript, JSON, HTML, CSS (result, vote front-end)
[*.{js,json,html,css}]
indent_style = space
indent_size = 2

# YAML (docker compose, k8s specifications, GitHub workflows)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# The healthcheck scripts are tab-indented
[healthchecks/*.sh]
indent_style = tab

# Markdown uses trailing double spaces for line breaks
[*.md]
trim_trailing_whitespace = false

# Vendored, minified third-party files: leave untouched
[result/views/{angular.min.js,socket.io.js}]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
